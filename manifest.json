{
  "manifest_version": 3,
  "name": "FU Study Kit: Exam Checklist & FAP Timetable",
  "version": "2.0.0",
  "description": "Track exam revision on FuOverflow and FuExam, flag unsure questions, and see your FAP weekly timetable in the popup. Not official.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://fuoverflow.com/*",
    "*://*.fuoverflow.com/*",
    "*://fuexam.me/*",
    "*://*.fuexam.me/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*"],
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*",
        "*://fuexam.me/*",
        "*://*.fuexam.me/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*",
        "*://fuexam.me/*",
        "*://*.fuexam.me/*"
      ],
      "js": ["lib/store-core.js", "lib/storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*",
        "*://fuexam.me/*",
        "*://*.fuexam.me/*"
      ],
      "js": ["lightbox.js"],
      "css": ["lightbox.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
