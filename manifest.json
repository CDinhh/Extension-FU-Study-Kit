{
  "manifest_version": 3,
  "name": "Exam Checklist for FuOverflow & FuExam",
  "version": "2.0.0",
  "description": "Tick exam threads you have reviewed on FuOverflow and FuExam, resume questions, flag unsure ones. Not official.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://fuoverflow.com/*",
    "*://*.fuoverflow.com/*",
    "*://fuexam.me/*",
    "*://*.fuexam.me/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*",
        "*://fuexam.me/*",
        "*://*.fuexam.me/*"
      ],
      "js": ["lib/store-core.js", "lib/storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://fuoverflow.com/*",
        "*://*.fuoverflow.com/*",
        "*://fuexam.me/*",
        "*://*.fuexam.me/*"
      ],
      "js": ["lightbox.js"],
      "css": ["lightbox.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
